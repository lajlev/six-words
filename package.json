{
  "name": "six-words",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "tsx scripts/seed.ts --prod",
    "migrate:add-language": "tsx scripts/migrateAddLanguage.ts",
    "migrate:add-language:prod": "tsx scripts/migrateAddLanguage.ts --prod",
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit=.emulator-data",
    "emulators:exec:test": "firebase emulators:exec --only firestore,auth \"vitest run test\"",
    "emulators:seed": "firebase emulators:exec --only firestore,auth --export-on-exit=.emulator-data \"npm run seed\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.2",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
