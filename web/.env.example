# Copy to .env.local (real Firebase project config) and/or .env.development (emulator mode).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lillefar-com.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lillefar-com
VITE_FIREBASE_STORAGE_BUCKET=lillefar-com.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only set once you've created a reCAPTCHA Enterprise key for this project (see README).
VITE_RECAPTCHA_SITE_KEY=

# Set to "true" for local dev against the Firebase Emulator Suite.
VITE_USE_EMULATORS=false
