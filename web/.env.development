# Used by `npm run dev` against the Firebase Emulator Suite. Values are
# dummies -- the emulators don't validate them -- so this file is safe to commit.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=lillefar-com.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lillefar-com
VITE_FIREBASE_STORAGE_BUCKET=lillefar-com.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_EMULATORS=true
